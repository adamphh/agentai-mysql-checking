# MySQL Monitor Bot - Environment Configuration

# ==================== MYSQL INSTANCES ====================

# Local MySQL Instance
MYSQL_LOCAL_HOST=localhost
MYSQL_LOCAL_PORT=3306
MYSQL_LOCAL_USER=monitor
MYSQL_LOCAL_PASSWORD=your_password_here
MYSQL_LOCAL_DATABASE=mysql

# Docker MySQL Instance
MYSQL_DOCKER_HOST=mysql-container
MYSQL_DOCKER_PORT=3306
MYSQL_DOCKER_USER=root
MYSQL_DOCKER_PASSWORD=your_docker_password_here
MYSQL_DOCKER_DATABASE=mysql

# AWS RDS MySQL Instance
MYSQL_AWS_HOST=db-prod.c9akciq32.us-east-1.rds.amazonaws.com
MYSQL_AWS_PORT=3306
MYSQL_AWS_USER=admin
MYSQL_AWS_PASSWORD=your_aws_password_here
MYSQL_AWS_DATABASE=mysql

# ==================== TELEGRAM ====================

# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh

# Allowed user IDs (comma-separated) - Get from @userinfobot
ALLOWED_USER_IDS=123456789,987654321,111111111

# Optional: Password for sensitive commands
TELEGRAM_PASSWORD=optional_password_for_sensitive_commands

# ==================== MONITORING SETTINGS ====================

# How often to collect metrics (milliseconds)
# 30000 = 30 seconds
METRICS_INTERVAL=30000

# Query timeout (milliseconds)
MONITORING_TIMEOUT=10000

# Keep history for X days
HISTORY_DAYS=7

# Hour to run daily cleanup (0-23, 24-hour format)
CLEANUP_HOUR=2

# ==================== LOGGING ====================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log file path
LOG_FILE=./logs/app.log

# ==================== ENVIRONMENT ====================

# Node environment: production or development
NODE_ENV=production
